# Virtual environments
BackEnd/api_v2/.venv/
BackEnd/**/__pycache__/
BackEnd/**/*.pyc

# Runtime-generated files
BackEnd/api_v2/app.db
BackEnd/api_v2/logs/

# Widget - exclude node_modules and any previous builds
frontend/chat-widget/node_modules/
frontend/chat-widget/dist/
frontend/chat-widget/releases/

# Exclude all other frontend apps (not needed for this image)
frontend/src/
frontend/node_modules/
frontend/dist/
frontend/admin-panel/

# Secrets (injected at runtime via docker-compose env_file)
**/.env
**/.env.local
**/.env.production

# Git and IDE
.git/
.gitignore
.vscode/
.idea/
