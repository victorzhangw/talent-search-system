# ── Stage 1: Build Chat Widget ─────────────────────────────────────
FROM node:20-slim AS widget-builder

WORKDIR /widget
COPY frontend/chat-widget/package*.json ./
RUN npm ci --prefer-offline
COPY frontend/chat-widget/ ./
RUN npm run build
# dist/ now contains: loader.iife.js, loader.css, images/

# ── Stage 2: Flask API Runtime ─────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY BackEnd/api_v2/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend source (preserves BackEnd.api_v2 package import path)
COPY BackEnd/__init__.py ./BackEnd/__init__.py
COPY BackEnd/api_v2/ ./BackEnd/api_v2/

# Copy built widget assets into Flask static folder → served at /widget/
COPY --from=widget-builder /widget/dist/ ./BackEnd/api_v2/static/widget/

EXPOSE 5000
ENV PYTHONPATH=/app

# gunicorn gthread workers support SSE streaming
CMD ["gunicorn", \
     "--bind", "0.0.0.0:5000", \
     "--workers", "2", \
     "--threads", "4", \
     "--timeout", "300", \
     "--worker-class", "gthread", \
     "BackEnd.api_v2.app:create_app()"]
