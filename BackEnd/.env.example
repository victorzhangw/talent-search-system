# 環境變數配置範例
# 複製此文件為 .env.local 並填入實際值

# 運行環境
ENVIRONMENT=development

# 資料庫配置
DB_SSH_HOST=your_ssh_host
DB_SSH_PORT=22
DB_SSH_USERNAME=your_ssh_username
DB_SSH_PRIVATE_KEY_FILE=private-key-openssh.pem
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# LLM API 配置
# API Key - 從 LLM 服務提供商獲取
LLM_API_KEY=your_llm_api_key_here

# API Host - LLM 服務的基礎 URL
LLM_API_HOST=https://api.siliconflow.cn

# 模型名稱
LLM_MODEL=deepseek-ai/DeepSeek-V3

# LLM 回答配置
# 最大回答長度（字數）
LLM_MAX_RESPONSE_LENGTH=300

# Temperature 參數（0.0-1.0，越高越有創意）
LLM_TEMPERATURE=0.7

# 最大 Token 數
LLM_MAX_TOKENS=700

# 應用配置
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Prompt 配置
# Prompt 模板存放在 BackEnd/prompts/ 目錄下
# 可以通過修改 JSON 文件來調整 Prompt 內容，無需修改代碼
