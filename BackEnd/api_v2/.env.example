# --- LLM ---
# 變數名以前是 DEEPSEEK_*，但 config/settings.py 讀的是 LLM_*，照舊名建出來的環境
# 會完全讀不到 API key。改成與 settings.py 一致。
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# --- 輸出速度 ---
# 模型思考模式。deepseek-v4-flash 是推理模型，開啟時會先串流 reasoning_content，
# 打包器只取 content，那段時間畫面上完全沒有東西——實測第一個答案 token 從 1.1 秒
# 變成 44-330 秒。預設關閉；若判定分析深度不足，改為 0 即可切回，不需改程式。
LLM_DISABLE_THINKING=1
# 前端逐字重播。關閉時分段閘門的每一段會整塊貼上（最長約 360 字一次跳出）。
TYPEWRITER_ENABLED=1
# 重播地板速度（字/秒）。落後時會自動加快，這個值只決定文字稀疏時看起來多快。
TYPEWRITER_CHARS_PER_SEC=60

# --- LOG 打包器 ---
# 1 = assemble -> 分段閘門 -> 稽核（預設）；0 = 退回舊的模組 prompt 路徑。
USE_LOG_PACKER=1

# --- 甲方整合 ---
PARTY_A_API_BASE=https://api.example.com/v1
PARTY_A_PLUGIN_SECRET=mock_secret
TRAITTY_API_BASE=https://api.example.com
INTEGRATION_MODE=REAL

# --- 資料庫 ---
DATABASE_URI=sqlite:///logs.db

# --- 對話 ---
MAX_HISTORY_TURNS=6
# 歷史標題的 OpenCC 簡->繁轉換。預設 0（關閉）。
# 開啟後會對模型回傳的標題做簡繁轉換，而簡->繁是一對多映射，套在本來就正確的繁體字上會改壞：
# 游->遊、余->餘、范->範、干預->幹預、公布->公佈。姓名現在改由後端用勾選的候選人名單填入，
# 模型不參與命名，所以這層通常不需要開。
TITLE_OPENCC_ENABLED=0
# 每筆 prompt 另外寫一份到 logs/<date>/prompts/<session_id>.log，方便逐段對話驗收。
# 彙總的 prompts.log 不受影響，兩邊都會寫。UAT 期間建議開啟；上線前需搭配清理策略。
PROMPT_LOG_PER_SESSION=0
# 每日全站 Token 上限（所有用戶合計）；0 = 不限制。
DAILY_TOKEN_LIMIT=0

# --- 開發端：在同一個後端上切換上游 Traitty 服務（見 utils/upstream_env.py）---------
# 預設關閉。打開之後，widget 可以送一個環境「名字」（不是網址），後端查表換成下面的網址。
# 正式部署不要打開——那等於讓客戶端決定後端要打哪一個上游。
ALLOW_UPSTREAM_ENV_SWITCH=0
TRAITTY_API_BASE_PRD=https://app.traitty.com
# UAT 與 PRD 不見得共用同一把 shared secret。若切到 PRD 之後上游回 401，
# 就是這裡要填 PRD 的那一把；留空則沿用 PARTY_A_PLUGIN_SECRET。
PARTY_A_PLUGIN_SECRET_PRD=
