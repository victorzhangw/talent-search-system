# UAT 資料庫連線 — 供 scripts/uat_db_check.py 使用（唯讀查詢）
#
# 複製本檔為 `.env.uat` 後填入，`.env.*` 已被 .gitignore 涵蓋，不會進版控。
# 不要把這些值寫進指令列參數：argv 會留在 shell history，也會出現在 process list。
#
# 這是「另外一份」連線設定，與 api_v2/.env 的 DB_* 無關，後端服務不會讀本檔。
# 這樣設計是為了讓查 UAT 這件事不需要改動後端當下連的資料庫。

UAT_DB_HOST=
UAT_DB_PORT=5432
UAT_DB_NAME=
UAT_DB_USER=
UAT_DB_PASSWORD=
