<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    
    <!-- 禁用 IIS 壓縮（對 SSE 串流很重要） -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    
    <!-- HTTP 協議設定 -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
    
    <!-- 反向代理設定 -->
    <rewrite>
      <rules>
        <!-- 將所有請求轉發到 Waitress (localhost:5000) -->
        <rule name="ReverseProxyToWaitress" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:5000/{R:1}" />
          <serverVariables>
            <!-- 禁用 Accept-Encoding 以防止 IIS 壓縮 -->
            <set name="HTTP_X_ORIGINAL_ACCEPT_ENCODING" value="{HTTP_ACCEPT_ENCODING}" />
            <set name="HTTP_ACCEPT_ENCODING" value="" />
          </serverVariables>
        </rule>
      </rules>
      
      <!-- 輸出規則：恢復 Accept-Encoding -->
      <outboundRules>
        <rule name="RestoreAcceptEncoding" preCondition="NeedsRestoringAcceptEncoding">
          <match serverVariable="HTTP_ACCEPT_ENCODING" pattern="^(.*)" />
          <action type="Rewrite" value="{HTTP_X_ORIGINAL_ACCEPT_ENCODING}" />
        </rule>
        <preConditions>
          <preCondition name="NeedsRestoringAcceptEncoding">
            <add input="{HTTP_X_ORIGINAL_ACCEPT_ENCODING}" pattern=".+" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
    
    <!-- 禁用 text/event-stream 的壓縮 -->
    <httpCompression>
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" />
      <dynamicTypes>
        <add mimeType="text/event-stream" enabled="false" />
        <add mimeType="application/json" enabled="true" />
      </dynamicTypes>
      <staticTypes>
        <add mimeType="text/event-stream" enabled="false" />
      </staticTypes>
    </httpCompression>
    
    <!-- 應用程式初始化（可選） -->
    <applicationInitialization doAppInitAfterRestart="true" skipManagedModules="true">
      <!-- 預熱端點，但不包括 /chat/ -->
      <add initializationPage="/api/v2/candidates/" />
    </applicationInitialization>
    
  </system.webServer>
</configuration>
